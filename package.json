{
  "name": "story-studio",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "license": "SEE LICENSE IN LICENSE.md",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "prepare": "simple-git-hooks",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "log": "git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --decorate --date=short | devmoji --log"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "devmoji": "catalog:dev",
    "eslint": "catalog:dev",
    "simple-git-hooks": "catalog:dev",
    "turbo": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "simple-git-hooks": {
    "prepare-commit-msg": "pnpm exec devmoji -e"
  }
}