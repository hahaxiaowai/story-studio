{
  "extends": "@story-studio/config/tsconfig/base",
  "compilerOptions": {
    "composite": true,
    "ignoreDeprecations": "6.0",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
